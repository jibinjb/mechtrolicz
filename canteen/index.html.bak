<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Canteen | Campus Dining & Live Queue Platform</title>
  <meta name="description" content="A modern university smart canteen management and online food ordering platform. Features live queue tracking, pre-ordering, digital campus wallet payments, inventory monitoring, and kitchen analytics.">
  <link rel="stylesheet" href="css/styles.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23FF5E00'><path d='M4 11h16a1 1 0 0 1 1 1c0 5-4 9-9 9s-9-4-9-9a1 1 0 0 1 1-1Z'/></svg>">
  <!-- Official Razorpay Checkout SDK -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>
<body>

  <!-- ================= Top Navigation Bar (Liquid Glass Header) ================= -->
  <header class="top-navbar">
    <div class="top-navbar-inner">
      <!-- Brand Logo -->
      <div class="nav-brand" onclick="window.studentPortal.switchStudentTab('home')">
        <div class="brand-crest">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11h16a1 1 0 0 1 1 1c0 5-4 9-9 9s-9-4-9-9a1 1 0 0 1 1-1Z"/>
            <path d="M7 4c1 2 0 4 0 5"/>
            <path d="M12 3c1 2 0 4 0 6"/>
            <path d="M17 4c1 2 0 4 0 5"/>
          </svg>
        </div>
        <div class="brand-text">
          <span class="brand-name">EAT, UP!</span>
          <span class="brand-subtext">Campus Wok & Dining</span>
        </div>
      </div>

      <!-- Navigation Links: Home, Menu -->
      <nav class="top-nav-links" aria-label="Main Navigation">
        <button class="top-nav-link active" data-tab="home" onclick="window.studentPortal.switchStudentTab('home')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span>Home</span>
        </button>
        <button class="top-nav-link" data-tab="menu" onclick="window.studentPortal.switchStudentTab('menu')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
            <path d="M7 2v20"/>
            <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
          </svg>
          <span>Menu</span>
        </button>
      </nav>

      <!-- Prominent Top Search Bar -->
      <div class="top-search-bar">
        <svg class="top-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
        <input type="text" id="menu-search-input" class="top-search-input" placeholder="Search biryani, noodles, meals, drinks..." />
      </div>

      <!-- Right Actions: Cart, Profile -->
      <div class="top-nav-actions">
        <!-- Cart Button -->
        <button class="nav-pill-btn cart-pill-btn" onclick="window.studentPortal.openCartDrawer()" aria-label="Shopping Tray" title="View Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="21" r="1"/>
            <circle cx="19" cy="21" r="1"/>
            <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
          </svg>
          <span class="btn-text">Cart</span>
          <span id="cart-badge" class="badge-counter" style="display: none;">0</span>
        </button>

        <!-- Profile / Auth Button -->
        <button id="top-profile-btn" class="nav-pill-btn profile-pill-btn" onclick="window.studentPortal.switchStudentTab('profile')" aria-label="Student Profile" title="Profile">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span class="btn-text">Profile</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ================= Main Content Container ================= -->
  <main class="main-content">

    <!-- =================================================================
         1. STUDENT PORTAL SECTION
         ================================================================= -->
    <section id="student-portal-wrapper">

      <!-- Hero Banner with Pre-Order Controls (Reference Replica Layout) -->
      <div id="student-hero-banner" class="hero-white-card">
        <div class="hero-left-content">
          <div class="hero-kicker-pill">
            <svg class="ui-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
            </svg>
            <span>LIVE CAMPUS DINING & WOK KITCHEN</span>
          </div>
          <h1 class="hero-title">
            Fresh Off <br />The Wok.
          </h1>
          <p class="hero-subtitle">
            Bold flavors. Fresh campus ingredients. Serious speed—skip the physical lines, pre-order your meals, and track preparation live in real time.
          </p>
          <div class="hero-cta-group">
            <button class="btn-primary" onclick="window.studentPortal.switchStudentTab('menu')">
              <span>Order Now</span>
              <svg class="ui-icon arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"/>
                <polyline points="7 7 17 7 17 17"/>
              </svg>
            </button>
            <button class="btn-secondary" onclick="window.studentPortal.switchStudentTab('menu')">
              View Menu
            </button>
          </div>
          <div class="hero-social-proof">
            <div class="avatar-group">
              <span class="avatar-bubble" style="background:#FFE6D5; color:#E44A00; font-weight:800; font-size:0.75rem;">AR</span>
              <span class="avatar-bubble" style="background:#FFEACC; color:#B45309; font-weight:800; font-size:0.75rem;">SK</span>
              <span class="avatar-bubble" style="background:#EBF5FF; color:#1D4ED8; font-weight:800; font-size:0.75rem;">MP</span>
              <span class="avatar-bubble" style="background:#FEF3C7; color:#D97706; font-weight:800; font-size:0.75rem;">VJ</span>
            </div>
            <div class="social-proof-text">Loved by <strong>5,000+</strong> campus foodies</div>
          </div>
        </div>

        <div class="hero-right-visual">
          <div class="hero-food-stage">
            <img src="assets/hero_noodles.jpg" alt="Fresh Off The Wok Noodles" class="hero-stage-img" />
            <!-- Floating Feature Glass Card: Wok-Fired Goodness -->
            <div class="wok-goodness-card">
              <div class="wok-card-badge">
                <svg class="ui-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
                </svg>
                <span>Wok-Fired Goodness</span>
              </div>
              <p class="wok-card-text">Every bowl is made fresh to order with real ingredients & bold flavor.</p>
              <button class="wok-card-link" onclick="window.studentPortal.switchStudentTab('tracker')">
                <span>Live Kitchen</span>
                <svg class="ui-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <line x1="7" y1="17" x2="17" y2="7"/>
                  <polyline points="7 7 17 7 17 17"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Pre-Order Card (Liquid Glass) -->
          <div class="preorder-card">
            <div class="preorder-card-header">
              <svg class="ui-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              <span>Pre-Order & Pickup Time</span>
            </div>
            <p class="preorder-card-desc">
              Select your preferred collection slot to have your meal ready when you arrive:
            </p>
            <div class="time-slots-grid">
              <button class="time-slot-btn active" data-time="ASAP" onclick="window.studentPortal.setPickupTime('ASAP')">
                <svg class="ui-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
                <span>ASAP</span>
              </button>
              <button class="time-slot-btn" data-time="12:30 PM" onclick="window.studentPortal.setPickupTime('12:30 PM')">12:30 PM</button>
              <button class="time-slot-btn" data-time="1:00 PM" onclick="window.studentPortal.setPickupTime('1:00 PM')">1:00 PM</button>
              <button class="time-slot-btn" data-time="1:30 PM" onclick="window.studentPortal.setPickupTime('1:30 PM')">1:30 PM</button>
            </div>
            <div class="campus-status-tags">
              <div class="campus-status-pill">
                <span class="status-bullet green"></span>
                <span>Kitchen: <strong>Open & Sizzling</strong></span>
              </div>
              <div class="campus-status-pill">
                <span class="status-bullet green"></span>
                <span>Est. Wait: <strong>6-8 mins</strong></span>
              </div>
              <div class="campus-status-pill">
                <svg class="ui-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
                <span>Counter 2 Active</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Subview: Home (Daily Specials & Popular Items) -->
      <div id="student-home-view"></div>

      <!-- Subview: Full Menu -->
      <div id="student-menu-view" style="display: none;">
        <!-- Category & Diet Filter Pills (Clean Premium SVGs) -->
        <div class="category-filter-row" style="margin-bottom: 2rem;">
          <div class="category-pills-bar">
            <button class="cat-pill-btn active" data-cat="all">
              <svg class="ui-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
              <span>All Items</span>
            </button>
            <button class="cat-pill-btn" data-cat="specials">
              <svg class="ui-icon star-icon" width="15" height="15" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <span>Today's Specials</span>
            </button>
            <button class="cat-pill-btn" data-cat="breakfast">
              <svg class="ui-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/></svg>
              <span>Breakfast</span>
            </button>
            <button class="cat-pill-btn" data-cat="lunch">
              <svg class="ui-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11h16a1 1 0 0 1 1 1c0 5-4 9-9 9s-9-4-9-9a1 1 0 0 1 1-1Z"/><path d="M7 4c1 2 0 4 0 5"/><path d="M12 3c1 2 0 4 0 6"/></svg>
              <span>Lunch & Meals</span>
            </button>
            <button class="cat-pill-btn" data-cat="snacks">
              <svg class="ui-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 10 10 4 4 0 0 1-5 5 4 4 0 0 1-5-5 4 4 0 0 1-5-5 4 4 0 0 1 5-5"/></svg>
              <span>Snacks & Bites</span>
            </button>
            <button class="cat-pill-btn" data-cat="beverages">
              <svg class="ui-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/></svg>
              <span>Beverages & Juices</span>
            </button>
          </div>

          <!-- Pure Veg / Non-Veg Toggle -->
          <div class="diet-toggle-group">
            <button class="diet-btn active" data-diet="all">All</button>
            <button class="diet-btn" data-diet="veg">
              <span class="diet-dot veg-dot"></span>
              <span>Veg Only</span>
            </button>
            <button class="diet-btn" data-diet="nonveg">
              <span class="diet-dot nonveg-dot"></span>
              <span>Non-Veg</span>
            </button>
          </div>
        </div>

        <div id="menu-grid" class="food-grid"></div>
      </div>

      <!-- Subview: Orders History -->
      <div id="student-orders-view" style="display: none;"></div>

      <!-- Subview: Live Order & Queue Tracker -->
      <div id="student-tracker-view" style="display: none;">
        <div id="order-tracker-container"></div>
      </div>

      <!-- Subview: Wallet -->
      <div id="student-wallet-view" style="display: none;"></div>

      <!-- Subview: Favorites -->
      <div id="student-favorites-view" style="display: none;"></div>

      <!-- Subview: Feedback -->
      <div id="student-feedback-view" style="display: none;"></div>

      <!-- Subview: Profile -->
      <div id="student-profile-view" style="display: none;"></div>

    </section>

    <!-- =================================================================
         2. ADMINISTRATOR & KITCHEN SECTION
         ================================================================= -->
    <section id="admin-portal-wrapper" style="display: none;">
      <!-- Dashboard Metrics -->
      <div class="admin-metrics-grid">
        <div class="admin-metric-card">
          <div class="metric-navy-icon">
            <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <div class="metric-details">
            <div id="metric-today-orders" class="metric-number">428</div>
            <div class="metric-text">Total Orders</div>
          </div>
        </div>

        <div class="admin-metric-card">
          <div class="metric-navy-icon">
            <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="metric-details">
            <div id="metric-pending-orders" class="metric-number">32</div>
            <div class="metric-text">Pending Orders</div>
          </div>
        </div>

        <div class="admin-metric-card">
          <div class="metric-navy-icon">
            <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="metric-details">
            <div id="metric-completed-orders" class="metric-number">381</div>
            <div class="metric-text">Completed Orders</div>
          </div>
        </div>

        <div class="admin-metric-card">
          <div class="metric-navy-icon">
            <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </div>
          <div class="metric-details">
            <div id="metric-cancelled-orders" class="metric-number">15</div>
            <div class="metric-text">Cancelled / Refunded</div>
          </div>
        </div>

        <div class="admin-metric-card">
          <div class="metric-navy-icon">
            <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          </div>
          <div class="metric-details">
            <div id="metric-today-sales" class="metric-number">₹38,450</div>
            <div class="metric-text">Today's Revenue</div>
          </div>
        </div>

        <div class="admin-metric-card">
          <div class="metric-navy-icon">
            <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <div class="metric-details">
            <div id="metric-low-stock" class="metric-number">2</div>
            <div class="metric-text">Low Stock Items</div>
          </div>
        </div>

        <div class="admin-metric-card">
          <div class="metric-navy-icon">
            <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="metric-details">
            <div id="metric-active-queue" class="metric-number">24</div>
            <div class="metric-text">Active Queue</div>
          </div>
        </div>
      </div>

      <!-- Admin Tab Views -->
      <div id="admin-orders-container"></div>
      <div id="admin-menu-container" style="display: none;"></div>
      <div id="admin-inventory-container" style="display: none;"></div>
      <div id="admin-analytics-container" style="display: none;"></div>
      <div id="admin-feedback-container" style="display: none;"></div>
    </section>

    <!-- ================= Canteen Footer (From Reference Image) ================= -->
    <footer class="canteen-main-footer">
      <div class="footer-top-row">
        <div class="footer-brand-col">
          <div class="footer-logo">
            <div class="footer-crest">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2">
                <path d="M4 11h16a1 1 0 0 1 1 1c0 5-4 9-9 9s-9-4-9-9a1 1 0 0 1 1-1Z"/>
                <path d="M7 4c1 2 0 4 0 5"/>
                <path d="M12 3c1 2 0 4 0 6"/>
                <path d="M17 4c1 2 0 4 0 5"/>
              </svg>
            </div>
            <span class="footer-brand-text">EAT, UP!</span>
          </div>
          <p class="footer-tagline">Fresh noodles. Bold flavors. Good vibes. University Smart Canteen Platform.</p>
          <div class="footer-hours-note" style="display: inline-flex; align-items: center; gap: 0.4rem;">
            <svg class="ui-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>Serving Campus Daily 8:00 AM – 10:00 PM</span>
          </div>
        </div>

        <div class="footer-nav-col">
          <div class="footer-col-title">MENU</div>
          <a href="javascript:void(0)" onclick="window.studentPortal.filterByCategory('lunch')">Wok Noodles</a>
          <a href="javascript:void(0)" onclick="window.studentPortal.filterByCategory('lunch')">Rice Bowls</a>
          <a href="javascript:void(0)" onclick="window.studentPortal.filterByCategory('snacks')">Sides & Snacks</a>
          <a href="javascript:void(0)" onclick="window.studentPortal.filterByCategory('beverages')">Drinks & Juices</a>
        </div>

        <div class="footer-nav-col">
          <div class="footer-col-title">CAMPUS</div>
          <a href="javascript:void(0)" onclick="window.studentPortal.switchStudentTab('tracker')">Live Queue Tracker</a>
          <a href="javascript:void(0)" onclick="window.studentPortal.switchStudentTab('favorites')">Saved Favorites</a>
          <a href="javascript:void(0)" onclick="window.studentPortal.switchStudentTab('orders')">Order Receipts</a>
        </div>

        <div class="footer-nav-col">
          <div class="footer-col-title">SUPPORT</div>
          <a href="javascript:void(0)" onclick="window.studentPortal.switchStudentTab('feedback')">Submit Feedback</a>
          <a href="javascript:void(0)" onclick="window.app.openNotifications()">Campus Notices</a>
        </div>
      </div>

      <div class="footer-bottom-row">
        <div>© 2026 EAT, UP! • Smart Campus Canteen Management Platform. All rights reserved.</div>
        <div style="display: flex; gap: 1rem;">
          <span>Nutritional Transparency</span>
          <span>•</span>
          <span>Campus Allergy Policy</span>
        </div>
      </div>
    </footer>

  </main>

  <!-- ================= Mobile Bottom Navigation Bar ================= -->
  <nav id="mobile-bottom-nav" class="mobile-bottom-nav" aria-label="Mobile Navigation">
    <button class="mobile-nav-btn active" data-tab="home" onclick="window.studentPortal.switchStudentTab('home')">
      <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      <span>Home</span>
    </button>
    <button class="mobile-nav-btn" data-tab="menu" onclick="window.studentPortal.switchStudentTab('menu')">
      <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
        <path d="M7 2v20"/>
        <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
      </svg>
      <span>Menu</span>
    </button>
    <button class="mobile-nav-btn" data-tab="tracker" onclick="window.studentPortal.switchStudentTab('tracker')">
      <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect width="20" height="12" x="2" y="6" rx="2"/>
        <line x1="12" y1="6" x2="12" y2="18" stroke-dasharray="2 2"/>
      </svg>
      <span>Track</span>
    </button>
    <button class="mobile-nav-btn" data-tab="orders" onclick="window.studentPortal.switchStudentTab('orders')">
      <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1Z"/>
        <path d="M16 8H8"/><path d="M16 12H8"/><path d="M12 16H8"/>
      </svg>
      <span>Orders</span>
    </button>
    <button class="mobile-nav-btn" data-tab="profile" onclick="window.studentPortal.switchStudentTab('profile')">
      <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
      <span>Profile</span>
    </button>
  </nav>

  <!-- ================= Cart Drawer (Liquid Glass & Dark Details) ================= -->
  <aside id="cart-drawer" class="cart-sidebar-drawer" aria-label="Shopping Cart Drawer">
    <div class="cart-drawer-top">
      <div style="display: flex; align-items: center; gap: 0.6rem; font-size: 1.15rem; font-weight: 700; font-family: var(--font-heading);">
        <svg class="ui-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--brand-orange)" stroke-width="2.2">
          <circle cx="8" cy="21" r="1"/>
          <circle cx="19" cy="21" r="1"/>
          <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
        </svg>
        <span>Your Meal Tray</span>
      </div>
      <button class="btn-close-clean" onclick="window.studentPortal.closeCartDrawer()" aria-label="Close cart">
        <svg class="ui-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div id="cart-items-list" class="cart-drawer-body"></div>
    <div id="cart-footer" class="cart-drawer-bottom" style="display: none;"></div>
  </aside>

  <!-- Direct Razorpay Checkout Integration Enabled -->

  <!-- ================= Food Item Add/Edit Modal (Admin) ================= -->
  <div id="edit-food-modal" class="modal-overlay">
    <div class="modal-dialog">
      <div class="modal-header-clean">
        <h3 id="food-modal-title" class="modal-heading">Edit Food Item</h3>
        <button class="btn-close-clean" onclick="document.getElementById('edit-food-modal').classList.remove('open')">
          <svg class="ui-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="modal-body-clean">
        <input type="hidden" id="food-id-input" />
        <div class="form-field-group">
          <label class="field-label" for="food-name-input">Food Item Name:</label>
          <input type="text" id="food-name-input" class="field-input" placeholder="e.g. Masala Dosa" />
        </div>
        <div style="display: flex; gap: 0.75rem;">
          <div class="form-field-group" style="flex: 1;">
            <label class="field-label" for="food-cat-input">Category:</label>
            <select id="food-cat-input" class="field-input">
              <option value="breakfast">Breakfast</option>
              <option value="lunch">Lunch & Meals</option>
              <option value="snacks">Snacks & Bites</option>
              <option value="beverages">Beverages</option>
            </select>
          </div>
          <div class="form-field-group" style="flex: 1;">
            <label class="field-label" for="food-price-input">Price (₹):</label>
            <input type="number" id="food-price-input" class="field-input" min="5" step="1" />
          </div>
        </div>
        <div style="display: flex; gap: 0.75rem;">
          <div class="form-field-group" style="flex: 1;">
            <label class="field-label" for="food-stock-input">Stock Portions:</label>
            <input type="number" id="food-stock-input" class="field-input" min="0" />
          </div>
          <div class="form-field-group" style="flex: 1;">
            <label class="field-label" for="food-prep-input">Prep Time (mins):</label>
            <input type="number" id="food-prep-input" class="field-input" min="1" />
          </div>
        </div>
        <div class="form-field-group">
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
            <input type="checkbox" id="food-veg-input" style="accent-color: var(--veg-color);" />
            <span>Mark as Pure Vegetarian</span>
            <span class="diet-dot veg-dot"></span>
          </label>
        </div>
        <div class="form-field-group">
          <label class="field-label" for="food-desc-input">Description / Ingredients:</label>
          <textarea id="food-desc-input" class="field-input" rows="3"></textarea>
        </div>
        <div class="form-field-group">
          <label class="field-label" for="food-image-input">Photo Selection:</label>
          <select id="food-image-input" class="field-input">
            <option value="assets/chicken_biryani.jpg">Chicken Dum Biryani</option>
            <option value="assets/veg_meals.jpg">Deluxe Veg Thali Meals</option>
            <option value="assets/paneer_fried_rice.jpg">Sizzling Paneer Fried Rice</option>
            <option value="assets/masala_dosa.jpg">Crispy Masala Dosa</option>
            <option value="assets/samosa_chai.jpg">Crispy Samosa & Masala Chai</option>
            <option value="assets/lime_juice.jpg">Chilled Fresh Lime Soda</option>
          </select>
        </div>
      </div>
      <div class="modal-footer-clean">
        <button class="btn-secondary" onclick="document.getElementById('edit-food-modal').classList.remove('open')">Cancel</button>
        <button class="btn-primary" onclick="window.adminConsole.saveFoodItem()">Save Item</button>
      </div>
    </div>
  </div>

  <!-- ================= Feedback Modal ================= -->
  <div id="feedback-modal" class="modal-overlay">
    <div class="modal-dialog">
      <div class="modal-header-clean">
        <h3 class="modal-heading">Rate Your Dining Experience</h3>
        <button class="btn-close-clean" onclick="window.studentPortal.closeFeedbackModal()">
          <svg class="ui-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="modal-body-clean">
        <div id="feedback-token-label" style="font-weight: 700; color: var(--primary-navy); margin-bottom: 1rem;">Order #A1042</div>

        <div class="form-field-group">
          <label class="field-label">Food Quality & Taste:</label>
          <div style="display: flex; gap: 4px; color: #FFB800;">
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
        </div>

        <div class="form-field-group">
          <label class="field-label">Service & Queue Speed:</label>
          <div style="display: flex; gap: 4px; color: #FFB800;">
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
        </div>

        <div class="form-field-group">
          <label class="field-label">Value for Money:</label>
          <div style="display: flex; gap: 4px; color: #FFB800;">
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="ui-icon star-icon" width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" stroke="#FFB800"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
        </div>

        <div class="form-field-group">
          <label class="field-label" for="feedback-comment-input">Comments or Suggestions:</label>
          <textarea id="feedback-comment-input" class="field-input" rows="3" placeholder="Tell canteen staff what you loved or how to improve..."></textarea>
        </div>
      </div>
      <div class="modal-footer-clean">
        <button class="btn-secondary" onclick="window.studentPortal.closeFeedbackModal()">Cancel</button>
        <button class="btn-primary" onclick="window.studentPortal.submitFeedback()">
          <span>Submit Review</span>
          <svg class="ui-icon star-icon" width="15" height="15" viewBox="0 0 24 24" fill="#FFFFFF" stroke="#FFFFFF"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ================= Interactive Firebase Authentication Modal ================= -->
  <div id="auth-modal" class="modal-overlay">
    <div class="auth-glass-card">
      <!-- Close button -->
      <button class="btn-close-clean" onclick="window.canteenAuth.closeAuthModal()" style="position: absolute; top: 1.25rem; right: 1.25rem;" aria-label="Close modal">
        <svg class="ui-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      <!-- Mandatory Booking Alert Banner (shown when triggered via booking/checkout) -->
      <div id="auth-mandatory-banner" class="auth-mandatory-banner" style="display: none;">
        <svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="flex-shrink: 0;">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span id="auth-banner-message">Sign In Required: Account authentication is mandatory to place meal bookings & receive your live queue token.</span>
      </div>

      <!-- Header & Brand Crest -->
      <div class="auth-header">
        <div class="auth-brand-logo">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8h1a4 4 0 1 1 0 8h-1"/>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4Z"/>
            <line x1="6" y1="2" x2="6" y2="4"/>
            <line x1="10" y1="2" x2="10" y2="4"/>
            <line x1="14" y1="2" x2="14" y2="4"/>
          </svg>
        </div>
        <h2 class="auth-title">Welcome to EAT, UP!</h2>
        <p class="auth-subtitle">Campus Dining, Pre-Ordering & Live Kitchen Platform</p>
      </div>

      <!-- Segmented Tab Switcher (Sign In vs Create Account) -->
      <div class="auth-tab-switcher">
        <div id="auth-tab-slider" class="auth-tab-slider"></div>
        <button id="auth-tab-signin" class="auth-tab-btn active" onclick="window.canteenAuth.switchTab('signin')">
          Sign In
        </button>
        <button id="auth-tab-signup" class="auth-tab-btn" onclick="window.canteenAuth.switchTab('signup')">
          Create Account
        </button>
      </div>

      <!-- Google Sign-In Button (Official Firebase Google Auth) -->
      <button class="auth-google-btn" onclick="window.canteenAuth.signInWithGoogle()" type="button">
        <svg width="19" height="19" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17Z"/>
          <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.34 24 12 24Z"/>
          <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.16 0 9.97 0 12s.45 3.84 1.25 5.42l4.03-3.15Z"/>
          <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98Z"/>
        </svg>
        <span>Continue with Google</span>
      </button>

      <!-- Divider -->
      <div class="auth-divider">
        <span>or continue with email</span>
      </div>

      <!-- Inline Alert Box -->
      <div id="auth-alert-box" class="auth-alert"></div>

      <!-- 1. Sign In Form -->
      <form id="auth-signin-form" onsubmit="window.canteenAuth.signInWithEmail(event)">
        <div class="auth-form-group">
          <label class="auth-label" for="signin-email">Campus Email</label>
          <div class="auth-input-wrapper">
            <svg class="auth-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <input type="email" id="signin-email" class="auth-input-field" placeholder="student@campus.edu.in" required autocomplete="email" />
          </div>
        </div>

        <div class="auth-form-group">
          <label class="auth-label" for="signin-password">Password</label>
          <div class="auth-input-wrapper">
            <svg class="auth-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <input type="password" id="signin-password" class="auth-input-field" placeholder="••••••••" required autocomplete="current-password" />
            <button type="button" class="auth-pwd-toggle" onclick="const p = document.getElementById('signin-password'); p.type = p.type === 'password' ? 'text' : 'password';" aria-label="Toggle password visibility">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="auth-row-actions">
          <button type="button" class="auth-link-btn" onclick="window.canteenAuth.handlePasswordReset()">Forgot Password?</button>
        </div>

        <button type="submit" id="btn-signin-submit" class="auth-submit-btn">
          <span>Sign In to Account</span>
          <svg class="ui-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </button>
      </form>

      <!-- 2. Sign Up Form -->
      <form id="auth-signup-form" onsubmit="window.canteenAuth.signUpWithEmail(event)" style="display: none;">
        <div class="auth-form-group">
          <label class="auth-label" for="signup-name">Full Name</label>
          <div class="auth-input-wrapper">
            <svg class="auth-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            <input type="text" id="signup-name" class="auth-input-field" placeholder="e.g. Aryan Varma" required autocomplete="name" />
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
          <div class="auth-form-group">
            <label class="auth-label" for="signup-studentid">Student ID / Roll No</label>
            <div class="auth-input-wrapper">
              <svg class="auth-input-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="18" height="14" x="3" y="5" rx="2"/>
                <path d="M7 15h4M15 15h2M7 11h2M7 7h10"/>
              </svg>
              <input type="text" id="signup-studentid" class="auth-input-field" placeholder="CS-2024-884" />
            </div>
          </div>

          <div class="auth-form-group">
            <label class="auth-label" for="signup-phone">Phone Number</label>
            <div class="auth-input-wrapper">
              <svg class="auth-input-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <input type="tel" id="signup-phone" class="auth-input-field" placeholder="+91 98765 43210" />
            </div>
          </div>
        </div>

        <div class="auth-form-group">
          <label class="auth-label" for="signup-email">Campus Email</label>
          <div class="auth-input-wrapper">
            <svg class="auth-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <input type="email" id="signup-email" class="auth-input-field" placeholder="student@campus.edu.in" required autocomplete="email" />
          </div>
        </div>

        <div class="auth-form-group">
          <label class="auth-label" for="signup-password">Password (min 6 characters)</label>
          <div class="auth-input-wrapper">
            <svg class="auth-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <input type="password" id="signup-password" class="auth-input-field" placeholder="Create a strong password" required autocomplete="new-password" minlength="6" />
            <button type="button" class="auth-pwd-toggle" onclick="const p = document.getElementById('signup-password'); p.type = p.type === 'password' ? 'text' : 'password';" aria-label="Toggle password visibility">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" id="btn-signup-submit" class="auth-submit-btn" style="margin-top: 1.25rem;">
          <span>Create Campus Account</span>
          <svg class="ui-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <line x1="19" y1="8" x2="19" y2="14"/>
            <line x1="22" y1="11" x2="16" y2="11"/>
          </svg>
        </button>
      </form>

      <!-- Instant 1-Click Campus Demo Sign-In Shortcut -->
      <div class="auth-demo-shortcut">
        <button class="auth-demo-btn" onclick="window.canteenAuth.quickDemoLogin()" type="button" title="Quick testing access">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          <span>Quick Campus Demo Sign In (1-Click)</span>
        </button>
      </div>

    </div>
  </div>

  <!-- ================= Notifications Modal ================= -->
  <div id="notifications-modal" class="modal-overlay">
    <div class="modal-dialog">
      <div class="modal-header-clean">
        <h3 class="modal-heading">Campus Dining Notifications</h3>
        <button class="btn-close-clean" onclick="window.app.closeNotifications()">
          <svg class="ui-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="modal-body-clean">
        <div id="notifications-list" style="display: flex; flex-direction: column; gap: 0.65rem;"></div>
      </div>
    </div>
  </div>

  <!-- ================= Toast Stack ================= -->
  <div id="toast-stack" class="toast-stack"></div>

  <!-- ================= Firebase Web SDK (Compat) ================= -->
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
  <script src="js/firebase-auth.js"></script>

  <!-- ================= Core Scripts ================= -->
  <script src="js/data.js"></script>
  <script src="js/storage.js"></script>
  <script src="js/audio.js"></script>
  <script src="js/student.js"></script>
  <script src="js/admin.js"></script>
  <script src="js/app.js"></script>

</body>
</html>
